# Blango Studio — copy to apps/blango/.env.local (never commit secrets)

# Public site URL (SEO canonical / Open Graph absolute URLs)
VITE_SITE_URL=https://www.blangostudio.com

# Meta (Facebook) Pixel — leave empty to disable tracking in dev
VITE_META_PIXEL_ID=

# Google Analytics 4 (gtag.js)
VITE_GA4_ID=G-6PJH1GP650
