# =============================================================================
# RIYANALUXE — Environment Variables
# Copy this file to `.env.local` inside apps/web/ and fill in real values.
# NEVER commit .env.local to git.
# =============================================================================

# ── Supabase (public — safe to bundle in the frontend) ───────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Site config ──────────────────────────────────────────────────────────────
VITE_SITE_URL=https://riyanaluxe.ma
VITE_BRAND_NAME=RIYANALUXE
VITE_BRAND_NAME_AR=ريانا لوكس

# ── WhatsApp (Morocco — digits only, no + sign) ─────────────────────────────
VITE_WHATSAPP_PHONE=2126XXXXXXXX

# ── Marketing pixels (leave blank until you have IDs) ────────────────────────
VITE_GA4_ID=
VITE_HOTJAR_ID=
VITE_TIKTOK_PIXEL_ID=
VITE_SNAP_PIXEL_ID=
VITE_META_PIXEL_ID=

# =============================================================================
# Admin API (apps/api — server only, never bundle in frontend)
# =============================================================================
# PORT=3001
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# ADMIN_API_KEY=use-a-long-random-secret
# CORS_ORIGIN=http://localhost:5175

# Admin dashboard (apps/admin/.env.local)
# VITE_API_URL=          # leave empty in dev — Vite proxies /api to :3001
# VITE_ADMIN_API_KEY=    # optional dev shortcut (prefer login screen)

# =============================================================================
# Supabase Edge Function secrets (set via `supabase secrets set` — NOT here)
# =============================================================================
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# WHATSAPP_CLOUD_API_TOKEN=EAA...
# WHATSAPP_PHONE_ID=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# RESEND_API_KEY=re_xxx
# TIKTOK_PIXEL_ACCESS_TOKEN=
# SNAP_CAPI_TOKEN=
# META_CAPI_TOKEN=
